# Compra Clara · Lavalleja — variables de entorno.
# Copiá este archivo a `.env` (scripts/Initialize-Environment.ps1 lo hace y genera los secretos).
# NUNCA subas `.env`. Las variables NEXT_PUBLIC/VITE_* no existen: el frontend no recibe secretos.

# --- Proyecto / red ---------------------------------------------------------
COMPOSE_PROJECT_NAME=compra-clara
# Puerto publicado SOLO en el entorno local (docker-compose.local.yml). En Coolify lo gestiona el dominio.
LOCAL_HTTP_PORT=8080
APP_ENV=production                 # production | local | test
# Origen público (dominio definitivo; se configura, no se adivina). Usado para CORS/CSRF/orígenes.
PUBLIC_ORIGIN=http://localhost:8080
COOKIE_SECURE=false                # true detrás de HTTPS
# Proxy de confianza: documentar la topología verificada. Solo activar si la API es inalcanzable fuera del proxy.
TRUST_PROXY=false
TRUSTED_PROXY_HOPS=1

# --- Base de datos (MariaDB) ------------------------------------------------
MARIADB_ROOT_PASSWORD=
MARIADB_DATABASE=compra_clara
MARIADB_USER=compra_clara
MARIADB_PASSWORD=
DATABASE_URI=                      # lo arma docker-compose.yml desde MARIADB_*; no completar a mano

# --- Backend ---------------------------------------------------------------
SECRET_KEY=
FLASK_DEBUG=0
SESSION_HOURS=8
AUTH_2FA_REQUIRED=true             # segundo factor por correo (patrón del boilerplate)
LOGIN_CAPTCHA=true
ALLOW_DEMO_SEED=false              # solo true en local/test; habilita `flask seed-demo`
MAX_UPLOAD_MB=10
TIMEZONE=America/Montevideo

# --- Correo (segundo factor) ------------------------------------------------
MAIL_SERVER=mailpit                # local/test: Mailpit. Producción: SMTP institucional
MAIL_PORT=1025
MAIL_USE_TLS=false
MAIL_USE_SSL=false
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=no-reply@compra-clara.invalid
MAIL_SUPPRESS_SEND=false

# --- Documentos (MinIO propio del proyecto) --------------------------------
DOCUMENT_STORAGE=local             # local (único cableado en compose; el adaptador MinIO no está conectado)
DOCUMENT_ROOT=/data/documents      # solo si DOCUMENT_STORAGE=local
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_SECURE=false
MINIO_BUCKET_NAME=compra-clara-docs
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# --- IA (Ollama). Mapa de variables de origen en docs/IA.md ----------------
AI_ENABLED=true
# Conexión directa a Ollama Cloud: https://ollama.com + OLLAMA_API_KEY (secreta, solo backend/worker).
# Conexión vía daemon Ollama del equipo (local Docker Desktop): http://host.docker.internal:11434, sin clave.
OLLAMA_HOST=https://ollama.com
OLLAMA_API_KEY=
OLLAMA_MODEL=                      # nombre exacto del modelo; no se cambia por preferencia
AI_EGRESS_POLICY=minimized         # off | metadata_only | minimized | full_text
AI_EGRESS_CLASSES=public,internal  # clasificaciones de documento que pueden salir al proveedor
AI_MAX_CONTEXT_CHARS=24000
AI_TIMEOUT_SECONDS=60
AI_MAX_CONCURRENCY=2
AI_MAX_RETRIES=1
AI_TOP_K=8
EMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDER=fastembed                 # fastembed | hash (solo pruebas unitarias)
MODEL_CACHE=/models

# --- Mailpit (solo local/test) ---------------------------------------------
MAILPIT_UI_PORT=8025
